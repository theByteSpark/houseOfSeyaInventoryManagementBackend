generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

model User {
  id                  String               @id @default(uuid())
  name                String
  email               String               @unique
  passwordHash        String
  role                Role                 @default(STAFF)
  refreshToken        String?
  passwordResetTokens PasswordResetToken[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  address   String?
  sales     Sale[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id            String        @id @default(uuid())
  name          String        @unique
  subcategories Subcategory[]
}

model Subcategory {
  id         String    @id @default(uuid())
  name       String
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id])
  products   Product[]

  @@unique([categoryId, name])
}

model Product {
  id                   String          @id @default(uuid())
  designNumber         String          @unique
  name                 String
  metalType            String?
  grossWeight          Decimal?        @db.Decimal(10, 3)
  metalRatePerGram     Decimal?        @db.Decimal(10, 2)
  makingChargePerGram  Decimal?        @db.Decimal(10, 2)
  fixedExpense         Decimal         @db.Decimal(10, 2) @default(0)
  sellingPrice         Decimal         @db.Decimal(10, 2)
  quantityInStock      Int             @default(0)
  reorderLevel         Int             @default(0)
  subcategoryId        String?
  subcategory          Subcategory?    @relation(fields: [subcategoryId], references: [id])
  diamonds             ProductDiamond[]
  saleItems            SaleItem[]
  purchaseItems        PurchaseItem[]
  stockMovements       StockMovement[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

model ProductDiamond {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  shape       String
  quality     String
  pieces      Int
  caratWeight Decimal  @db.Decimal(10, 3)
  weight      Decimal  @db.Decimal(10, 3)
  rate        Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  @@index([productId])
}

enum AttributeType {
  METAL
  DIAMOND_SHAPE
  DIAMOND_QUALITY
}

model AttributeOption {
  id        String        @id @default(uuid())
  type      AttributeType
  label     String
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())

  @@unique([type, label])
}

enum StockMovementType {
  RESTOCK
  SALE
  ADJUSTMENT
}

model StockMovement {
  id        String            @id @default(uuid())
  productId String
  product   Product           @relation(fields: [productId], references: [id])
  type      StockMovementType
  quantity  Int
  reason    String?
  createdAt DateTime          @default(now())
}

enum SaleStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

model Sale {
  id            String     @id @default(uuid())
  saleNumber    String     @unique
  customerId    String
  customer      Customer   @relation(fields: [customerId], references: [id])
  status        SaleStatus @default(DRAFT)
  items         SaleItem[]
  subtotal      Decimal    @db.Decimal(10, 2)
  tax           Decimal    @db.Decimal(10, 2) @default(0)
  total         Decimal    @db.Decimal(10, 2)
  issuedAt      DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  lineTotal Decimal @db.Decimal(10, 2)
}

model Vendor {
  id            String          @id @default(uuid())
  companyName   String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  purchases     Purchase[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model Purchase {
  id                String         @id @default(uuid())
  purchaseNumber    String         @unique
  vendorId          String
  vendor            Vendor         @relation(fields: [vendorId], references: [id])
  status            PurchaseStatus @default(DRAFT)
  items             PurchaseItem[]
  orderedAt         DateTime?
  receivedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model PurchaseItem {
  id               String   @id @default(uuid())
  purchaseId       String
  purchase         Purchase @relation(fields: [purchaseId], references: [id])
  productId        String
  product          Product  @relation(fields: [productId], references: [id])
  quantity         Int
  receivedQuantity Int      @default(0)
  unitCost         Decimal  @db.Decimal(10, 2)
  lineTotal        Decimal  @db.Decimal(10, 2)
}
